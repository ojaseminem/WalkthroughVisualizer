{
  "name": "walkthrough-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Tag-driven WebGL walkthrough system for archviz, healthcare and facility digital experiences",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wv/viewer",
    "build": "npm run build --workspace @wv/viewer",
    "preview": "npm run preview --workspace @wv/viewer",
    "scene": "cd tools/modelgen && python3 generate_tower.py ../../apps/viewer/public/content/kp-tower/scene.glb",
    "verify": "node tools/verify/capture.mjs --serve apps/viewer/dist",
    "check": "npm run scene && npm run build && npm run verify",
    "verify:ci": "node tools/verify/capture.mjs --serve apps/viewer/dist --shots low --shot-budget 300000"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
